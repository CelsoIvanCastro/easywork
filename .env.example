# Copia generada por `npm run setup` en .env (con secretos aleatorios). No subas .env.
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Base de datos -------------------------------------------------------
# Local: PostgreSQL embebido (npm run db) en este puerto.
PG_PORT=54329
PG_SUPERUSER_PASSWORD=cambia-esto
APP_DB_PASSWORD=cambia-esto
# Rol de la aplicación (privilegios mínimos, sin UPDATE/DELETE sobre auditoría).
DATABASE_URL=postgresql://easywork_app:cambia-esto@127.0.0.1:54329/easywork
# Propietario del esquema, solo para migraciones.
MIGRATE_DATABASE_URL=postgresql://postgres:cambia-esto@127.0.0.1:54329/easywork
# Base de pruebas separada. Los tests se niegan a correr si el nombre no termina en _test.
TEST_DATABASE_URL=postgresql://easywork_app:cambia-esto@127.0.0.1:54329/easywork_test
TEST_MIGRATE_DATABASE_URL=postgresql://postgres:cambia-esto@127.0.0.1:54329/easywork_test

# --- Autenticación (Better Auth) ----------------------------------------
BETTER_AUTH_SECRET=genera-32-bytes-aleatorios
BETTER_AUTH_URL=http://localhost:3000

# --- Cifrado de campos sensibles ----------------------------------------
# Lista "id:base64(32 bytes)" separada por comas; la clave vigente es ENCRYPTION_KEY_CURRENT.
# Rotación: añade una clave nueva, cámbiala a vigente y ejecuta `npm run keys:rotate`.
ENCRYPTION_KEYS=k1:BASE64_32_BYTES
ENCRYPTION_KEY_CURRENT=k1
# Clave para índices ciegos (búsqueda exacta de RFC/CURP/NSS). No se rota sin reindexar.
BLIND_INDEX_KEY=BASE64_32_BYTES

# --- Almacenamiento privado ---------------------------------------------
STORAGE_DRIVER=local            # local | s3
STORAGE_DIR=.local/storage
# S3 compatible (producción):
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Análisis de archivos -----------------------------------------------
FILE_SCAN=off                   # off | clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# En producción pon true: sin analizador disponible, las cargas quedan en cuarentena.
FILE_SCAN_REQUIRED=false

# --- Correo transaccional -----------------------------------------------
MAIL_DRIVER=local               # local (buzón en .local/mailbox) | smtp
MAIL_FROM="EasyWork <no-reply@example.test>"
SMTP_URL=

# --- IA empresarial -----------------------------------------------------
# none | anthropic | openai-compatible (p. ej. un servidor local compatible).
AI_PROVIDER=none
# Con anthropic, modelo recomendado: claude-opus-5-5 (se usa con respaldo del servidor ante rechazos).
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=60000

# --- Producción: proxy, cabeceras y salud --------------------------------
# Cabecera con la IP real que SOBRESCRIBE tu proxy (obligatoria en producción; no uses x-forwarded-for).
IP_HEADER=x-real-ip
# true solo si TODOS los subdominios del dominio usan HTTPS.
HSTS_INCLUDE_SUBDOMAINS=false
# Token para ver el detalle de /api/salud/listo en producción.
HEALTH_TOKEN=
# Orígenes permitidos de las apps (CORS + Better Auth). Por defecto: capacitor://localhost,https://localhost,tauri://localhost,http://tauri.localhost
CLIENT_ORIGINS=
# Exige verificación en dos pasos para acciones privilegiadas (recomendado true).
REQUIRE_PRIVILEGED_2FA=true

# --- Operador (textos legales) -------------------------------------------
OPERATOR_NAME=
OPERATOR_KIND=
OPERATOR_LOCATION=
OPERATOR_EMAIL=
# Pon true cuando un profesional haya revisado privacidad y términos (quita el aviso de borrador).
OPERATOR_LEGAL_REVIEWED=false

# --- Eliminaciones -------------------------------------------------------
# Libro de eliminaciones para reaplicarlas tras restaurar una copia. En producción: almacenamiento separado de los backups.
ERASURE_LEDGER=.local/erasure-ledger.jsonl
