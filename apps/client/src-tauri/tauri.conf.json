{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyWork",
  "version": "1.0.0",
  "identifier": "com.celsocastro.easywork",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      { "label": "main", "title": "EasyWork", "width": 1280, "height": 840, "minWidth": 380, "minHeight": 560, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https:; frame-src 'self' blob:; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "category": "Business",
    "shortDescription": "Administración empresarial",
    "copyright": "© 2026 Celso Iván Castro Vizcarra",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "entitlements": null, "hardenedRuntime": true },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
